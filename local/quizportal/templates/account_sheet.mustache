{{!
    @template local_quizportal/account_sheet

    The account list to print and hand out, after a class is made
    (newclass_report) or students are added to one (students.php). Printing
    the page prints this and nothing else (styles.css, @media print).

    Context variables required for this template:
    * fullname - the class
    * loginurl
    * accounts - [{email, fullname, password, isnew, suspended}]

    Example context (json):
    {
        "fullname": "TOEIC 650+ K10", "loginurl": "http://localhost/moodle/local/quizportal/login.php",
        "accounts": [
            {"email": "an@gmail.com", "fullname": "Nguyễn Văn An", "password": "19102004", "isnew": true, "suspended": false},
            {"email": "binh@gmail.com", "fullname": "Trần Bình", "password": null, "isnew": false, "suspended": true}
        ]
    }
}}
<section class="quizportal-accounts">
    <h3 class="h5">Tài khoản học viên — {{fullname}}</h3>
    <p>Đăng nhập tại <strong>{{loginurl}}</strong> bằng email. Học viên mới: mật khẩu là ngày sinh viết liền.</p>
    <table class="table table-sm table-bordered quizportal-newclass__table">
        <thead>
            <tr>
                <th scope="col">Họ và tên</th>
                <th scope="col">Tên đăng nhập</th>
                <th scope="col">Mật khẩu</th>
            </tr>
        </thead>
        <tbody>
            {{#accounts}}
                <tr>
                    <td>{{fullname}}{{#suspended}} <span class="badge badge-warning">tài khoản đang bị khoá</span>{{/suspended}}</td>
                    <td>{{email}}</td>
                    <td>{{#isnew}}<code>{{password}}</code>{{/isnew}}{{^isnew}}mật khẩu cũ của bạn{{/isnew}}</td>
                </tr>
            {{/accounts}}
        </tbody>
    </table>
</section>
